# KetoPilot Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!

# Gmail SMTP configuration for sending emails
# Get an app password from: Google Account > Security > App Passwords
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Supabase configuration (optional - defaults are in env_config.dart)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Build command examples:
# flutter run --dart-define=GMAIL_EMAIL=xxx --dart-define=GMAIL_APP_PASSWORD=xxx
# flutter build apk --dart-define=GMAIL_EMAIL=xxx --dart-define=GMAIL_APP_PASSWORD=xxx

# For CI/CD (GitHub Actions), add these as repository secrets:
# - GMAIL_EMAIL
# - GMAIL_APP_PASSWORD
